# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/delivery_tracker"

# --- NextAuth ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Email (SMTP) ---
# Works with Gmail (use an App Password), Mailtrap, Brevo, or any SMTP free tier.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Delivery Tracker <no-reply@delivery-tracker.local>"

# --- SMS (Twilio free trial) ---
# Sign up at https://www.twilio.com/try-twilio (no credit card for trial).
# Free trial provides a real phone number and ~15 SMS credits.
# Leave blank in local dev — the app will log [sms:mock] to the console instead.
# Note: Twilio trial accounts can only send to verified phone numbers.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+15005550006"

